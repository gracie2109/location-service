# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Optional until step S3. Without it /ready answers 503.
DATABASE_URL=postgres://location:location@localhost:5432/location

# Seconds between checks for a newly imported catalog version (default 60)
# CATALOG_REFRESH_SECONDS=60

# Requests per minute per IP on public routes (default 60) and trusted reverse proxies (default 0)
# PUBLIC_RATE_LIMIT_PER_MIN=60
# TRUST_PROXY_HOPS=0

# Only for `npm run providers -- sync`. Put real values in GitHub Secrets or a local .env, never in git.
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn   # staging; default is production
